local NODE_BY_ID = {}
for _, n in ipairs(BODY_NODES) do NODE_BY_ID[n.id] = n end

local BODY_LINKS = {
  {12, 11}, {11, 10}, {10, 9}, {9, 2},
  {10, 13}, {13, 15}, {15, 17}, {17, 19},
  {10, 14}, {14, 16}, {16, 18}, {18, 20},
  {2, 3}, {3, 5}, {5, 7}, {7, 23},
  {2, 4}, {4, 6}, {6, 8}, {8, 24},
}

Doa6Pose_WantShow = false

-- Preserve saved poses across table reloads, upgrade UI cleanly if version changed
if Doa6Pose and Doa6Pose.ui and Doa6Pose.ui.uiVersion ~= UI_VERSION then
  if Doa6Pose.ui.form then pcall(function() Doa6Pose.ui.form.hide() end) end
  Doa6Pose.ui = nil
end

Doa6Pose = Doa6Pose or {
  slot = 0,
  bone = 15,
  hoverBone = nil,
  state = { [0] = {}, [1] = {} },
  ui = nil,
  updating = false,
  hookActive = false,
  lastBase = nil,
  watchTimer = nil,
  hkF6 = nil,
  hkF8 = nil,
  hkF9 = nil,
}

local function safeRun(tag, fn)
  local ok, err = pcall(fn)
  if not ok then
    print("[doa6_pose " .. tag .. " ERROR] " .. tostring(err))
  end
end

local function getBase()
  local a = getAddressSafe("g_poseData")
  if a and a ~= 0 then return a end
  return nil
end

-- Rotation vector (Exponential Map in degrees) -> unit quaternion (x, y, z, w)
-- Eliminates Euler gimbal lock at Y = ±90° (where XYZ Euler makes X and Z rotate the same axis)
local function eulerToQuat(rxDeg, ryDeg, rzDeg)
  local len = math.sqrt(rxDeg * rxDeg + ryDeg * ryDeg + rzDeg * rzDeg)
  if len < 1e-5 then
    return 0, 0, 0, 1
  end
  local halfRad = len * (math.pi / 360.0)
  local s = math.sin(halfRad) / len
  return rxDeg * s, ryDeg * s, rzDeg * s, math.cos(halfRad)
end

local function getBoneState(slot, boneId)
  local s = Doa6Pose.state[slot][boneId]
  if not s then
    s = { rx = 0, ry = 0, rz = 0, px = 0, py = 0, pz = 0 }
    Doa6Pose.state[slot][boneId] = s
  end
  return s
end

local function isBoneModified(slot, boneId)
  local s = Doa6Pose.state[slot][boneId]
  if not s then return false end
  return math.abs(s.rx) > 1e-4 or math.abs(s.ry) > 1e-4 or math.abs(s.rz) > 1e-4
      or math.abs(s.px) > 1e-4 or math.abs(s.py) > 1e-4 or math.abs(s.pz) > 1e-4
end

local function repaintBody()
  local ui = Doa6Pose.ui
  if ui and ui.pbBody then
    pcall(function() ui.pbBody.repaint() end)
  end
end

local function writeBoneToMem(slot, boneId)
  local base = getBase()
  if not base then return end
  if boneId < 0 or boneId >= MAX_BONES then return end
  local s = getBoneState(slot, boneId)
  local addr = base + DELTA_BASE[slot] + boneId * 32
  local flags = 0
  if math.abs(s.rx) > 1e-4 or math.abs(s.ry) > 1e-4 or math.abs(s.rz) > 1e-4 then
    local qx, qy, qz, qw = eulerToQuat(s.rx, s.ry, s.rz)
    writeFloat(addr + 0x00, qx)
    writeFloat(addr + 0x04, qy)
    writeFloat(addr + 0x08, qz)
    writeFloat(addr + 0x0C, qw)
    flags = flags + 1
  else
    writeFloat(addr + 0x00, 0)
    writeFloat(addr + 0x04, 0)
    writeFloat(addr + 0x08, 0)
    writeFloat(addr + 0x0C, 1)
  end
  if math.abs(s.px) > 1e-4 or math.abs(s.py) > 1e-4 or math.abs(s.pz) > 1e-4 then
    writeFloat(addr + 0x10, s.px)
    writeFloat(addr + 0x14, s.py)
    writeFloat(addr + 0x18, s.pz)
    flags = flags + 2
  else
    writeFloat(addr + 0x10, 0)
    writeFloat(addr + 0x14, 0)
    writeFloat(addr + 0x18, 0)
  end
  writeInteger(addr + 0x1C, flags)
end

local function flushAllToMem()
  local base = getBase()
  if not base then return end
  for slot = 0, 1 do
    local dbase = base + DELTA_BASE[slot]
    for i = 0, MAX_BONES - 1 do
      writeInteger(dbase + i * 32 + 0x1C, 0)
    end
    for boneId, _ in pairs(Doa6Pose.state[slot]) do
      writeBoneToMem(slot, boneId)
    end
  end
end

local function setFreeze(slot, on)
  local base = getBase()
  if not base then return end
  writeInteger(base + 0x28 + slot * 4, on and 1 or 0)
  if on then
    writeInteger(base + 0x30 + slot * 4, 0)
  end
end

local function recapture(slot)
  local base = getBase()
  if not base then return end
  writeInteger(base + 0x30 + slot * 4, 0)
  beep()
end

local function setEnable(slot, on)
  local base = getBase()
  if not base then return end
  writeInteger(base + 0x38 + slot * 4, on and 1 or 0)
end

local function syncUIFromState()
  local ui = Doa6Pose.ui
  if not ui or not ui.form or not ui.tbRX then return end
  Doa6Pose.updating = true
  local s = getBoneState(Doa6Pose.slot, Doa6Pose.bone)
  local rx = math.floor(s.rx + 0.5)
  local ry = math.floor(s.ry + 0.5)
  local rz = math.floor(s.rz + 0.5)
  local px = math.floor(s.px + 0.5)
  local py = math.floor(s.py + 0.5)
  local pz = math.floor(s.pz + 0.5)

  ui.tbRX.Position = rx
  ui.tbRY.Position = ry
  ui.tbRZ.Position = rz
  ui.tbPX.Position = px
  ui.tbPY.Position = py
  ui.tbPZ.Position = pz

  ui.lblRX.Caption = string.format("X 旋转: %+4d°", rx)
  ui.lblRY.Caption = string.format("Y 旋转: %+4d°", ry)
  ui.lblRZ.Caption = string.format("Z 旋转: %+4d°", rz)
  ui.lblPX.Caption = string.format("X 平移: %+4d cm", px)
  ui.lblPY.Caption = string.format("Y 平移: %+4d cm", py)
  ui.lblPZ.Caption = string.format("Z 平移: %+4d cm", pz)

  local bname = BONE_NAME_BY_ID[Doa6Pose.bone] or (tostring(Doa6Pose.bone) .. " 自定义骨骼")
  ui.lblActiveBone.Caption = "当前关节: " .. bname
  ui.edBoneId.Text = tostring(Doa6Pose.bone)
  local idx = BONE_INDEX_BY_ID[Doa6Pose.bone]
  if idx ~= nil then ui.cbBone.ItemIndex = idx end
  ui.cbSlot.ItemIndex = Doa6Pose.slot

  local base = getBase()
  if base then
    ui.cbEnable.Checked = (readInteger(base + 0x38 + Doa6Pose.slot * 4) or 1) ~= 0
    ui.cbFreeze.Checked = (readInteger(base + 0x28 + Doa6Pose.slot * 4) or 0) ~= 0
  end
  Doa6Pose.updating = false
  repaintBody()
end

local function updateStatus()
  local ui = Doa6Pose.ui
  if not ui or not ui.lblStatus then return end
  local base = getBase()
  if not base then
    ui.lblStatus.Caption = "状态: 钩子未启用"
    return
  end
  local p1 = readQword(base + 0x08) or 0
  local p2 = readQword(base + 0x10) or 0
  local n1 = readInteger(base + 0x20) or 0
  local n2 = readInteger(base + 0x24) or 0
  local cnt = readInteger(base + 0x04) or 0
  ui.lblStatus.Caption = string.format(
    "状态: 运行中 (帧=%d) | P1: %s(%d骨) | P2: %s(%d骨) | 快捷键: F6面板 F8冻结 F9重抓",
    cnt,
    p1 ~= 0 and "已锁定" or "等待", n1,
    p2 ~= 0 and "已锁定" or "等待", n2
  )
end

local function hitTestNode(x, y)
  local bestId, bestD2 = nil, 20 * 20
  for _, n in ipairs(BODY_NODES) do
    local dx, dy = x - n.x, y - n.y
    if n.isRoot then
      if math.abs(dx) <= 30 and math.abs(dy) <= 13 then
        return n.id
      end
    else
      local d2 = dx * dx + dy * dy
      if d2 <= bestD2 then
        bestD2 = d2
        bestId = n.id
      end
    end
  end
  return bestId
end

local function drawHumanCanvas(pb)
  local c = pb.Canvas
  local w, h = pb.Width, pb.Height

  -- Dark slate background (Lazarus TColor is 0xBBGGRR)
  c.Brush.Color = 0x28201E
  c.Pen.Color = 0x3F3530
  c.Pen.Width = 1
  c.fillRect(0, 0, w, h)
  c.rect(0, 0, w - 1, h - 1)

  -- Subtle center vertical axis
  c.Pen.Color = 0x3A312C
  c.line(130, 26, 130, 466)

  -- Header labels (front view: character's right on left, character's left on right)
  c.Font.Color = 0xB8A59A
  c.Font.Size = 8
  c.textOut(10, 8, "<- 右侧(R)")
  c.textOut(102, 8, "正面视图")
  c.textOut(190, 8, "左侧(L) ->")

  -- Stylized human silhouette (soft muted body shapes behind skeleton)
  c.Brush.Color = 0x433731
  c.Pen.Color = 0x52453E
  c.Pen.Width = 1
  -- Head oval
  c.ellipse(106, 30, 154, 84)
  -- Neck
  c.roundRect(121, 82, 139, 114, 4, 4)
  -- Upper torso (chest)
  c.roundRect(96, 112, 164, 180, 22, 22)
  -- Waist
  c.roundRect(105, 170, 155, 224, 18, 18)
  -- Hips / Pelvis
  c.roundRect(92, 214, 168, 276, 26, 26)

  -- Thick limb silhouettes
  c.Pen.Color = 0x433731
  c.Pen.Width = 14
  c.line(164, 122, 198, 144); c.line(198, 144, 216, 210); c.line(216, 210, 228, 276)
  c.line(96, 122, 62, 144);   c.line(62, 144, 44, 210);   c.line(44, 210, 32, 276)
  c.Pen.Width = 18
  c.line(162, 268, 168, 352); c.line(98, 268, 92, 352)
  c.Pen.Width = 13
  c.line(168, 352, 172, 432); c.line(92, 352, 88, 432)
  c.Pen.Width = 10
  c.line(172, 432, 204, 450); c.line(88, 432, 56, 450)

  -- Skeleton bone links
  c.Pen.Color = 0x9B7E6E
  c.Pen.Width = 2
  for _, lk in ipairs(BODY_LINKS) do
    local a, b = NODE_BY_ID[lk[1]], NODE_BY_ID[lk[2]]
    if a and b then
      c.line(a.x, a.y, b.x, b.y)
    end
  end

  -- Joint nodes
  for _, n in ipairs(BODY_NODES) do
    local isSel = (n.id == Doa6Pose.bone)
    local isHov = (n.id == Doa6Pose.hoverBone)
    local isMod = isBoneModified(Doa6Pose.slot, n.id)
    local r = n.r

    if isSel then
      -- Outer selection glow ring
      c.Brush.Color = 0x28201E
      c.Pen.Color = 0xFFFFFF
      c.Pen.Width = 2
      c.ellipse(n.x - r - 4, n.y - r - 4, n.x + r + 4, n.y + r + 4)
      c.Brush.Color = 0x1A9FFF -- bright orange-gold (BGR)
      c.Pen.Color = 0xFFFFFF
      c.Pen.Width = 2
    elseif isMod then
      c.Brush.Color = 0x71CC2E -- emerald green (BGR)
      c.Pen.Color = isHov and 0xFFFFFF or 0xC8F0A8
      c.Pen.Width = isHov and 2 or 1
    else
      c.Brush.Color = isHov and 0xFFA054 or 0xA89282
      c.Pen.Color = isHov and 0xFFFFFF or 0xE6DCD4
      c.Pen.Width = isHov and 2 or 1
    end

    if n.isRoot then
      c.roundRect(n.x - 28, n.y - 10, n.x + 28, n.y + 10, 6, 6)
      c.Font.Color = isSel and 0x101010 or 0xFFFFFF
      c.Font.Size = 8
      c.textOut(n.x - 22, n.y - 7, "整体根骨")
    else
      c.ellipse(n.x - r, n.y - r, n.x + r, n.y + r)
    end
  end

  -- Hover or Selected tooltip banner near bottom of canvas
  local tipId = Doa6Pose.hoverBone or Doa6Pose.bone
  local tipName = BONE_NAME_BY_ID[tipId] or ("骨 " .. tostring(tipId))
  c.Brush.Color = 0x352B27
  c.Pen.Color = 0x4E423C
  c.Pen.Width = 1
  c.fillRect(8, h - 24, w - 8, h - 4)
  c.Font.Color = 0x55CCFF
  c.Font.Size = 8
  local prefix = Doa6Pose.hoverBone and "悬停: " or "已选: "
  c.textOut(14, h - 21, prefix .. tipName)
end

local function savePoseFile()
  local dlg = createSaveDialog(Doa6Pose.ui.form)
  dlg.Title = "保存当前角色姿态"
  dlg.Filter = "DOA6 Pose (*.pose)|*.pose|All Files (*.*)|*.*"
  dlg.DefaultExt = "pose"
  if not dlg.Execute() then dlg.destroy() return end
  local path = dlg.FileName
  dlg.destroy()
  local f, err = io.open(path, "w")
  if not f then showMessage("保存失败: " .. tostring(err)) return end
  f:write("# DOA6_POSE_V1\n")
  local slot = Doa6Pose.slot
  for boneId, s in pairs(Doa6Pose.state[slot]) do
    if isBoneModified(slot, boneId) then
      f:write(string.format("%d %.3f %.3f %.3f %.3f %.3f %.3f\n",
        boneId, s.rx, s.ry, s.rz, s.px, s.py, s.pz))
    end
  end
  f:close()
  showMessage("已保存姿态到:\n" .. path)
end

local function loadPoseFile()
  local dlg = createOpenDialog(Doa6Pose.ui.form)
  dlg.Title = "加载姿态到当前角色"
  dlg.Filter = "DOA6 Pose (*.pose)|*.pose|All Files (*.*)|*.*"
  if not dlg.Execute() then dlg.destroy() return end
  local path = dlg.FileName
  dlg.destroy()
  local f, err = io.open(path, "r")
  if not f then showMessage("读取失败: " .. tostring(err)) return end
  local slot = Doa6Pose.slot
  Doa6Pose.state[slot] = {}
  for line in f:lines() do
    local id, rx, ry, rz, px, py, pz = line:match("^(%d+)%s+([%-%d%.]+)%s+([%-%d%.]+)%s+([%-%d%.]+)%s+([%-%d%.]+)%s+([%-%d%.]+)%s+([%-%d%.]+)")
    if id then
      Doa6Pose.state[slot][tonumber(id)] = {
        rx = tonumber(rx), ry = tonumber(ry), rz = tonumber(rz),
        px = tonumber(px), py = tonumber(py), pz = tonumber(pz),
      }
    end
  end
  f:close()
  flushAllToMem()
  syncUIFromState()
end

local function buildUI()
  if Doa6Pose.ui and Doa6Pose.ui.uiVersion == UI_VERSION and Doa6Pose.ui.form and Doa6Pose.ui.tbRX then
    Doa6Pose.ui.form.show()
    Doa6Pose.ui.form.bringToFront()
    syncUIFromState()
    return
  end

  local f = createForm(false)
  f.DoNotSaveInTable = true
  f.Caption = "DOA6 角色姿态修改器 (点击关节控制 · 布料/碰撞联动)"
  f.Width = 748
  f.Height = 585
  f.centerScreen()
  pcall(function() f.FormStyle = "fsStayOnTop" end)

  local ui = { form = f, uiVersion = UI_VERSION }
  Doa6Pose.ui = ui
  Doa6Pose.updating = true

  -- Top status bar
  local lblStatus = createLabel(f)
  lblStatus.Left = 12; lblStatus.Top = 8; lblStatus.Width = 724
  lblStatus.Caption = "状态: 等待游戏帧..."
  ui.lblStatus = lblStatus

  -- ================= LEFT: Interactive Human Body Panel =================
  local pnlBody = createPanel(f)
  pnlBody.Left = 12; pnlBody.Top = 32; pnlBody.Width = 260; pnlBody.Height = 516
  pnlBody.DoubleBuffered = true
  ui.pnlBody = pnlBody

  local pb = createPaintBox(pnlBody)
  pb.Left = 0; pb.Top = 0; pb.Width = 260; pb.Height = 516
  pb.OnPaint = function(sender)
    safeRun("PaintBody", function() drawHumanCanvas(sender) end)
  end

  local function handleBodyClick(x, y, isRight)
    local hit = hitTestNode(x, y)
    if not hit then return end
    if isRight then
      Doa6Pose.state[Doa6Pose.slot][hit] = { rx=0, ry=0, rz=0, px=0, py=0, pz=0 }
      writeBoneToMem(Doa6Pose.slot, hit)
      Doa6Pose.bone = hit
      syncUIFromState()
    else
      Doa6Pose.bone = hit
      syncUIFromState()
    end
  end

  -- Guaranteed left-click handler using documented Control.OnClick + getMousePos + screenToClient
  pb.OnClick = function()
    safeRun("BodyClick", function()
      local mx, my = getMousePos()
      local cx, cy = pnlBody.screenToClient(mx, my)
      handleBodyClick(cx, cy, false)
    end)
  end

  -- Enhanced mouse down (instant right-click reset) & hover highlight using getMousePos + screenToClient
  pcall(function()
    pb.OnMouseDown = function(sender, button)
      safeRun("BodyMouseDown", function()
        local mx, my = getMousePos()
        local cx, cy = pnlBody.screenToClient(mx, my)
        if button == 1 or button == "mbRight" then
          handleBodyClick(cx, cy, true)
        elseif button == 0 or button == "mbLeft" then
          handleBodyClick(cx, cy, false)
        end
      end)
    end
    pb.OnMouseMove = function()
      safeRun("BodyHover", function()
        local mx, my = getMousePos()
        local cx, cy = pnlBody.screenToClient(mx, my)
        local h = hitTestNode(cx, cy)
        if h ~= Doa6Pose.hoverBone then
          Doa6Pose.hoverBone = h
          pb.repaint()
        end
      end)
    end
  end)
  ui.pbBody = pb

  local lblLegend = createLabel(f)
  lblLegend.Left = 12; lblLegend.Top = 554; lblLegend.Width = 260
  lblLegend.Caption = "左键=选关节  右键=归零  橙=选中  绿=已改"

  -- ================= RIGHT: Joint Sliders & Controls =================
  local rx0 = 286
  local y = 32

  -- Row 1: Character slot + Enable
  local lblSlot = createLabel(f)
  lblSlot.Caption = "角色:"; lblSlot.Left = rx0; lblSlot.Top = y + 4

  local cbSlot = createComboBox(f)
  cbSlot.Left = rx0 + 40; cbSlot.Top = y; cbSlot.Width = 95
  cbSlot.Items.add("角色 P1")
  cbSlot.Items.add("角色 P2")
  cbSlot.ItemIndex = Doa6Pose.slot
  cbSlot.OnChange = function()
    if Doa6Pose.updating then return end
    safeRun("SlotChange", function()
      if cbSlot.ItemIndex >= 0 then
        Doa6Pose.slot = cbSlot.ItemIndex
        syncUIFromState()
      end
    end)
  end
  ui.cbSlot = cbSlot

  local cbEnable = createCheckBox(f)
  cbEnable.Caption = "启用修改"; cbEnable.Left = rx0 + 148; cbEnable.Top = y + 2; cbEnable.Checked = true
  cbEnable.OnChange = function()
    if Doa6Pose.updating then return end
    safeRun("EnableChange", function() setEnable(Doa6Pose.slot, cbEnable.Checked) end)
  end
  ui.cbEnable = cbEnable

  local cbFreeze = createCheckBox(f)
  cbFreeze.Caption = "冻结动画(F8)"; cbFreeze.Left = rx0 + 245; cbFreeze.Top = y + 2; cbFreeze.Checked = false
  cbFreeze.OnChange = function()
    if Doa6Pose.updating then return end
    safeRun("FreezeChange", function() setFreeze(Doa6Pose.slot, cbFreeze.Checked) end)
  end
  ui.cbFreeze = cbFreeze
  y = y + 32

  -- Row 2: Recapture & Relock
  local btnRecap = createButton(f)
  btnRecap.Caption = "重新捕获当前帧 (F9)"; btnRecap.Left = rx0; btnRecap.Top = y; btnRecap.Width = 210; btnRecap.Height = 26
  btnRecap.OnClick = function()
    safeRun("Recap", function()
      setFreeze(Doa6Pose.slot, true)
      recapture(Doa6Pose.slot)
      syncUIFromState()
    end)
  end

  local btnRelock = createButton(f)
  btnRelock.Caption = "重新识别 P1/P2"; btnRelock.Left = rx0 + 220; btnRelock.Top = y; btnRelock.Width = 212; btnRelock.Height = 26
  btnRelock.OnClick = function()
    safeRun("Relock", function()
      local base = getBase()
      if base then
        writeQword(base + 0x08, 0)
        writeQword(base + 0x10, 0)
        writeInteger(base + 0x30, 0)
        writeInteger(base + 0x34, 0)
      end
    end)
  end
  y = y + 36

  -- Row 3: Active bone title
  local lblActiveBone = createLabel(f)
  lblActiveBone.Left = rx0; lblActiveBone.Top = y; lblActiveBone.Width = 432
  pcall(function() lblActiveBone.Font.Size = 10; lblActiveBone.Font.Color = 0xAA4400 end)
  lblActiveBone.Caption = "当前关节: 15 左上臂 (L UpperArm)"
  ui.lblActiveBone = lblActiveBone
  y = y + 24

  -- Row 4: Full bone list dropdown (including fingers) + manual bone ID
  local cbBone = createComboBox(f)
  cbBone.Left = rx0; cbBone.Top = y; cbBone.Width = 315
  local selIdx = 0
  for i, b in ipairs(BONE_LIST) do
    cbBone.Items.add(b.name)
    if b.id == Doa6Pose.bone then selIdx = i - 1 end
  end
  cbBone.ItemIndex = selIdx
  cbBone.OnChange = function()
    if Doa6Pose.updating then return end
    safeRun("BoneChange", function()
      local idx = cbBone.ItemIndex
      if idx >= 0 and BONE_LIST[idx + 1] then
        Doa6Pose.bone = BONE_LIST[idx + 1].id
        syncUIFromState()
      end
    end)
  end
  ui.cbBone = cbBone

  local edBoneId = createEdit(f)
  edBoneId.Left = rx0 + 324; edBoneId.Top = y; edBoneId.Width = 52; edBoneId.Text = tostring(Doa6Pose.bone)
  ui.edBoneId = edBoneId

  local btnGoBone = createButton(f)
  btnGoBone.Caption = "跳转"; btnGoBone.Left = rx0 + 382; btnGoBone.Top = y - 1; btnGoBone.Width = 50; btnGoBone.Height = 24
  btnGoBone.OnClick = function()
    safeRun("GoBone", function()
      local n = tonumber(edBoneId.Text)
      if n and n >= 0 and n < MAX_BONES then
        Doa6Pose.bone = math.floor(n)
        syncUIFromState()
      end
    end)
  end
  y = y + 36

  -- Helper to add a slider row (with optional step buttons for rotation)
  local function addSlider(labelPrefix, unit, minV, maxV, fieldKey, withSteps)
    local lbl = createLabel(f)
    lbl.Left = rx0; lbl.Top = y + 4; lbl.Width = 108
    lbl.Caption = string.format("%s:   +0%s", labelPrefix, unit)

    local tb = createTrackBar(f)
    tb.Left = rx0 + 110; tb.Top = y; tb.Width = withSteps and 178 or 272; tb.Height = 28
    tb.Min = minV; tb.Max = maxV; tb.Position = 0

    local function applyVal(v)
      if v < minV then v = minV end
      if v > maxV then v = maxV end
      lbl.Caption = string.format("%s: %+4d%s", labelPrefix, v, unit)
      if Doa6Pose.updating then return end
      local s = getBoneState(Doa6Pose.slot, Doa6Pose.bone)
      s[fieldKey] = v
      writeBoneToMem(Doa6Pose.slot, Doa6Pose.bone)
      repaintBody()
    end

    if withSteps then
      local function addStepBtn(cap, bx, delta)
        local btn = createButton(f)
        btn.Caption = cap; btn.Left = bx; btn.Top = y + 2; btn.Width = 30; btn.Height = 24
        btn.OnClick = function()
          safeRun("Step", function()
            local nv = tb.Position + delta
            if nv < minV then nv = minV end
            if nv > maxV then nv = maxV end
            tb.Position = nv
            applyVal(nv)
          end)
        end
      end
      addStepBtn("-15", rx0 + 292, -15)
      addStepBtn("-5",  rx0 + 324, -5)
      addStepBtn("+5",  rx0 + 356, 5)
      addStepBtn("+15", rx0 + 388, 15)
    end

    local btnZero = createButton(f)
    btnZero.Caption = "0"
    btnZero.Left = withSteps and (rx0 + 420) or (rx0 + 390)
    btnZero.Top = y + 2
    btnZero.Width = withSteps and 24 or 42
    btnZero.Height = 24

    tb.OnChange = function() safeRun("Slide", function() applyVal(tb.Position) end) end
    btnZero.OnClick = function() safeRun("Zero", function() tb.Position = 0; applyVal(0) end) end

    y = y + 36
    return lbl, tb
  end

  ui.lblRX, ui.tbRX = addSlider("X 旋转", "°", -180, 180, "rx", true)
  ui.lblRY, ui.tbRY = addSlider("Y 旋转", "°", -180, 180, "ry", true)
  ui.lblRZ, ui.tbRZ = addSlider("Z 旋转", "°", -180, 180, "rz", true)
  y = y + 8
  ui.lblPX, ui.tbPX = addSlider("X 平移", " cm", -150, 150, "px", false)
  ui.lblPY, ui.tbPY = addSlider("Y 平移", " cm", -150, 150, "py", false)
  ui.lblPZ, ui.tbPZ = addSlider("Z 平移", " cm", -150, 150, "pz", false)
  y = y + 12

  -- Action buttons row 1: Reset current / Mirror to opposite side
  local btnResetBone = createButton(f)
  btnResetBone.Caption = "归零当前关节"; btnResetBone.Left = rx0; btnResetBone.Top = y; btnResetBone.Width = 210; btnResetBone.Height = 29
  btnResetBone.OnClick = function()
    safeRun("ResetBone", function()
      Doa6Pose.state[Doa6Pose.slot][Doa6Pose.bone] = { rx=0, ry=0, rz=0, px=0, py=0, pz=0 }
      writeBoneToMem(Doa6Pose.slot, Doa6Pose.bone)
      syncUIFromState()
    end)
  end

  local btnMirror = createButton(f)
  btnMirror.Caption = "镜像复制到对侧关节"; btnMirror.Left = rx0 + 220; btnMirror.Top = y; btnMirror.Width = 212; btnMirror.Height = 29
  btnMirror.OnClick = function()
    safeRun("Mirror", function()
      local opp = MIRROR_PAIR[Doa6Pose.bone]
      if not opp then
        showMessage("当前选中的是中轴骨骼，没有左右对侧关节")
        return
      end
      local s = getBoneState(Doa6Pose.slot, Doa6Pose.bone)
      Doa6Pose.state[Doa6Pose.slot][opp] = {
        rx = -s.rx, ry = -s.ry, rz = s.rz,
        px = s.px,  py = s.py,  pz = -s.pz,
      }
      writeBoneToMem(Doa6Pose.slot, opp)
      repaintBody()
    end)
  end
  y = y + 36

  -- Action buttons row 2: Reset all / Copy pose to other player
  local btnResetAll = createButton(f)
  btnResetAll.Caption = "归零当前角色全部关节"; btnResetAll.Left = rx0; btnResetAll.Top = y; btnResetAll.Width = 210; btnResetAll.Height = 29
  btnResetAll.OnClick = function()
    safeRun("ResetAll", function()
      Doa6Pose.state[Doa6Pose.slot] = {}
      flushAllToMem()
      syncUIFromState()
    end)
  end

  local btnCopySlot = createButton(f)
  btnCopySlot.Caption = "复制当前姿势到 P1/P2"; btnCopySlot.Left = rx0 + 220; btnCopySlot.Top = y; btnCopySlot.Width = 212; btnCopySlot.Height = 29
  btnCopySlot.OnClick = function()
    safeRun("CopySlot", function()
      local src = Doa6Pose.slot
      local dst = 1 - src
      Doa6Pose.state[dst] = {}
      for bid, st in pairs(Doa6Pose.state[src]) do
        Doa6Pose.state[dst][bid] = { rx=st.rx, ry=st.ry, rz=st.rz, px=st.px, py=st.py, pz=st.pz }
      end
      flushAllToMem()
      showMessage(string.format("已将 P%d 姿势复制到 P%d", src + 1, dst + 1))
    end)
  end
  y = y + 36

  -- Action buttons row 3: Save / Load pose
  local btnSave = createButton(f)
  btnSave.Caption = "保存姿态到文件..."; btnSave.Left = rx0; btnSave.Top = y; btnSave.Width = 210; btnSave.Height = 29
  btnSave.OnClick = function() safeRun("Save", savePoseFile) end

  local btnLoad = createButton(f)
  btnLoad.Caption = "从文件加载姿态..."; btnLoad.Left = rx0 + 220; btnLoad.Top = y; btnLoad.Width = 212; btnLoad.Height = 29
  btnLoad.OnClick = function() safeRun("Load", loadPoseFile) end

  Doa6Pose.updating = false
  f.show()
  f.bringToFront()
  syncUIFromState()
end

local function uncheckShowEntry()
  local al = getAddressList()
  if not al then return end
  local mr = al.getMemoryRecordByID(2)
  if mr and mr.Active then
    mr.Active = false
  end
end

local function registerHotkeys()
  if Doa6Pose.hkF6 then pcall(function() Doa6Pose.hkF6.destroy() end); Doa6Pose.hkF6 = nil end
  if Doa6Pose.hkF8 then pcall(function() Doa6Pose.hkF8.destroy() end); Doa6Pose.hkF8 = nil end
  if Doa6Pose.hkF9 then pcall(function() Doa6Pose.hkF9.destroy() end); Doa6Pose.hkF9 = nil end
  Doa6Pose.hkF6 = createHotkey(function()
    safeRun("F6", function()
      if Doa6Pose.ui and Doa6Pose.ui.form and Doa6Pose.ui.form.Visible then
        Doa6Pose.ui.form.hide()
      else
        buildUI()
      end
    end)
  end, 117) -- VK_F6
  Doa6Pose.hkF8 = createHotkey(function()
    safeRun("F8", function()
      local base = getBase()
      if not base then return end
      local cur = (readInteger(base + 0x28 + Doa6Pose.slot * 4) or 0) ~= 0
      setFreeze(Doa6Pose.slot, not cur)
      syncUIFromState()
    end)
  end, 119) -- VK_F8
  Doa6Pose.hkF9 = createHotkey(function()
    safeRun("F9", function()
      setFreeze(Doa6Pose.slot, true)
      recapture(Doa6Pose.slot)
      syncUIFromState()
    end)
  end, 120) -- VK_F9
end

local function clearHotkeys()
  if Doa6Pose.hkF6 then pcall(function() Doa6Pose.hkF6.destroy() end); Doa6Pose.hkF6 = nil end
  if Doa6Pose.hkF8 then pcall(function() Doa6Pose.hkF8.destroy() end); Doa6Pose.hkF8 = nil end
  if Doa6Pose.hkF9 then pcall(function() Doa6Pose.hkF9.destroy() end); Doa6Pose.hkF9 = nil end
end

local function watchTick()
  safeRun("Watch", function()
    local base = getBase()
    if base then
      if (not Doa6Pose.hookActive) or (Doa6Pose.lastBase ~= base) then
        Doa6Pose.hookActive = true
        Doa6Pose.lastBase = base
        flushAllToMem()
        buildUI()
        registerHotkeys()
      end
      if Doa6Pose_WantShow then
        Doa6Pose_WantShow = false
        buildUI()
        uncheckShowEntry()
      end
      updateStatus()
    else
      if Doa6Pose.hookActive then
        Doa6Pose.hookActive = false
        Doa6Pose.lastBase = nil
        clearHotkeys()
        if Doa6Pose.ui and Doa6Pose.ui.form then
          Doa6Pose.ui.form.hide()
        end
      end
      if Doa6Pose_WantShow then
        Doa6Pose_WantShow = false
        uncheckShowEntry()
        showMessage("请先勾选「1. 启用 DOA6 姿态修改器」")
      end
    end
  end)
end

-- Main-thread watcher timer (reused across table reloads, never destroyed inside OnTimer)
if not Doa6Pose.watchTimer then
  Doa6Pose.watchTimer = createTimer(getMainForm(), false)
end
Doa6Pose.watchTimer.Interval = 300
Doa6Pose.watchTimer.OnTimer = watchTick
Doa6Pose.watchTimer.Enabled = true

print("[doa6_pose] Lua 脚本已加载，请附加 DOA6.exe 后勾选「1. 启用 DOA6 姿态修改器」。")
]]></LuaScript>
</CheatTable>
