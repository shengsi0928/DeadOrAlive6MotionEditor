<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"1. 启用 DOA6 姿态修改器（勾选后自动弹出面板）"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[
[ENABLE]
aobscanmodule(DOA6_UpdateParts,DOA6.exe,?? ?? ?? ?? ?? 55 56 57 41 54 41 55 41 56 41 57 48 81 EC 80 00 00 00 44 8B 69 14 48 8B EA 48 8B)
alloc(newmem,4096,DOA6_UpdateParts)
alloc(g_poseData,65536,DOA6_UpdateParts)

label(code)
label(return)
label(hook_done)
label(claim_p1)
label(claim_p2)
label(is_p1)
label(is_p2)
label(run_slot)
label(saved_ready)
label(do_restore)
label(not_frozen)
label(after_freeze)
label(delta_ready)
label(bone_loop)
label(check_pos)
label(next_bone)
label(sync_children)
label(child_loop)
label(next_child)
label(compose_bone)

// g_poseData header (64KB total; alloc zeroes the rest)
// +0x0000: header
// +0x0100: P1 deltas (256 * 32 = 0x2000)
// +0x2100: P2 deltas (256 * 32 = 0x2000)
// +0x4100: P1 savedPose (256 * 48 = 0x3000)
// +0x7100: P2 savedPose (256 * 48 = 0x3000)
g_poseData:
  dd 1          // +0x00 global_enable = 1
  dd 0          // +0x04 call_counter
  dq 0          // +0x08 p1_skel
  dq 0          // +0x10 p2_skel
  dd 0          // +0x18 p1_last_seen
  dd 0          // +0x1C p2_last_seen
  dd 0          // +0x20 p1_bone_count
  dd 0          // +0x24 p2_bone_count
  dd 0          // +0x28 p1_freeze
  dd 0          // +0x2C p2_freeze
  dd 0          // +0x30 p1_captured
  dd 0          // +0x34 p2_captured
  dd 1          // +0x38 p1_enable
  dd 1          // +0x3C p2_enable
  dq 0          // +0x40 p1_lp
  dq 0          // +0x48 p2_lp

newmem:
  pushfq
  push rax
  push rbx
  push rcx
  push rdx
  push rsi
  push rdi
  push r8
  push r9
  push r10
  push r11
  push r12
  push r13
  push r14
  push r15
  push rbp
  sub rsp, 0D0
  movups [rsp], xmm0
  movups [rsp+10], xmm1
  movups [rsp+20], xmm2
  movups [rsp+30], xmm3
  movups [rsp+40], xmm4
  movups [rsp+50], xmm5
  movups [rsp+60], xmm6
  movups [rsp+70], xmm7

  mov r14, g_poseData
  cmp dword ptr [r14], 0
  je hook_done

  // Validate CharPartMgr (rcx): partCount at +0x14, parts array (stride 0xC0) at +0x38
  test rcx, rcx
  je hook_done
  mov eax, [rcx+14]
  cmp eax, 1
  jl hook_done
  cmp eax, 10
  jg hook_done
  mov [rsp+0B8], eax              // partCount
  mov rdx, [rcx+38]
  test rdx, rdx
  je hook_done
  mov [rsp+0B0], rdx              // parts ptr

  // part[0] -> wrapper -> CModel(+0x20) -> CSkeleton(+0x150)
  mov rax, [rdx]
  test rax, rax
  je hook_done
  mov rax, [rax+20]
  test rax, rax
  je hook_done
  mov rbp, [rax+150]              // rbp = bodySkel
  test rbp, rbp
  je hook_done

  // Validate bodySkel boneCount (80..256)
  mov rax, [rbp]
  test rax, rax
  je hook_done
  mov rax, [rax]
  test rax, rax
  je hook_done
  movsx r12d, word ptr [rax+04]
  cmp r12d, 50                    // 80
  jl hook_done
  cmp r12d, 100                   // 256
  jg hook_done

  mov r13, [rbp+10]               // r13 = bodyLp (48 bytes/bone)
  test r13, r13
  je hook_done

  // Verify DOA6 body skeleton parent chain:
  // bone0=-1, bone3=2, bone4=2, bone9=2, bone13=10, bone14=10
  mov eax, [r13+0C]
  inc eax
  jnz hook_done
  cmp dword ptr [r13+9C], 2
  jne hook_done
  cmp dword ptr [r13+0CC], 2
  jne hook_done
  cmp dword ptr [r13+1BC], 2
  jne hook_done
  cmp dword ptr [r13+27C], 0A
  jne hook_done
  cmp dword ptr [r13+2AC], 0A
  jne hook_done

  // Thread-safe body call counter
  lock inc dword ptr [r14+04]
  mov eax, [r14+04]

  // Match or auto-claim P1 / P2 slot by bodySkel (rbp)
  cmp rbp, [r14+08]
  je is_p1
  cmp rbp, [r14+10]
  je is_p2

  cmp qword ptr [r14+08], 0
  je claim_p1
  mov r8d, eax
  sub r8d, [r14+18]
  cmp r8d, 8
  ja claim_p1

  cmp qword ptr [r14+10], 0
  je claim_p2
  mov r8d, eax
  sub r8d, [r14+1C]
  cmp r8d, 8
  ja claim_p2
  jmp hook_done

claim_p1:
  mov [r14+08], rbp
  mov dword ptr [r14+30], 0
  jmp is_p1

claim_p2:
  mov [r14+10], rbp
  mov dword ptr [r14+34], 0
  jmp is_p2

is_p1:
  mov [r14+18], eax
  mov [r14+20], r12d
  mov [r14+40], r13
  xor r15d, r15d
  jmp run_slot

is_p2:
  mov [r14+1C], eax
  mov [r14+24], r12d
  mov [r14+48], r13
  mov r15d, 1

run_slot:
  // byte size = boneCount * 48 -> rbx
  mov rbx, r12
  add rbx, r12
  add rbx, r12
  shl rbx, 4

  // slot header base -> r8 (r14 + slot*4)
  mov r8, r15
  shl r8, 2
  add r8, r14

  // savedPose ptr -> r10 (P1: +0x4100, P2: +0x7100)
  lea r10, [r14+4100]
  test r15d, r15d
  je saved_ready
  lea r10, [r14+7100]
saved_ready:
  // Check freeze flag: [r8+28]
  cmp dword ptr [r8+28], 0
  je not_frozen

  // Check captured flag: [r8+30]
  cmp dword ptr [r8+30], 0
  jne do_restore

  // Capture current local pose -> savedPose
  cld
  mov rsi, r13
  mov rdi, r10
  mov rcx, rbx
  rep movsb
  mov dword ptr [r8+30], 1
  jmp after_freeze

do_restore:
  // Restore savedPose -> local pose
  cld
  mov rsi, r10
  mov rdi, r13
  mov rcx, rbx
  rep movsb
  jmp after_freeze

not_frozen:
  mov dword ptr [r8+30], 0

after_freeze:
  // Check per-player enable: [r8+38]
  cmp dword ptr [r8+38], 0
  je sync_children

  // Deltas ptr -> rdi (P1: +0x0100, P2: +0x2100)
  lea rdi, [r14+0100]
  test r15d, r15d
  je delta_ready
  lea rdi, [r14+2100]
delta_ready:
  mov rsi, r13
  xor r9d, r9d

bone_loop:
  cmp r9d, r12d
  jge sync_children

  mov eax, [rdi+1C]
  test eax, eax
  jz next_bone

  // Bit 0: quaternion multiply q' = q * dq
  test eax, 1
  jz check_pos

  // ox = qw*dx + qx*dw + qy*dz - qz*dy
  movss xmm0, [rsi+1C]
  mulss xmm0, [rdi]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+0C]
  addss xmm0, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+08]
  addss xmm0, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+04]
  subss xmm0, xmm4

  // oy = qw*dy - qx*dz + qy*dw + qz*dx
  movss xmm1, [rsi+1C]
  mulss xmm1, [rdi+04]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+08]
  subss xmm1, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+0C]
  addss xmm1, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi]
  addss xmm1, xmm4

  // oz = qw*dz + qx*dy - qy*dx + qz*dw
  movss xmm2, [rsi+1C]
  mulss xmm2, [rdi+08]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+04]
  addss xmm2, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi]
  subss xmm2, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+0C]
  addss xmm2, xmm4

  // ow = qw*dw - qx*dx - qy*dy - qz*dz
  movss xmm3, [rsi+1C]
  mulss xmm3, [rdi+0C]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi]
  subss xmm3, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+04]
  subss xmm3, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+08]
  subss xmm3, xmm4

  movss [rsi+10], xmm0
  movss [rsi+14], xmm1
  movss [rsi+18], xmm2
  movss [rsi+1C], xmm3

check_pos:
  // Bit 1: position offset pos' = pos + dpos
  test eax, 2
  jz next_bone
  movss xmm0, [rsi+20]
  addss xmm0, [rdi+10]
  movss [rsi+20], xmm0
  movss xmm1, [rsi+24]
  addss xmm1, [rdi+14]
  movss [rsi+24], xmm1
  movss xmm2, [rsi+28]
  addss xmm2, [rdi+18]
  movss [rsi+28], xmm2

next_bone:
  add rsi, 30
  add rdi, 20
  inc r9d
  jmp bone_loop

sync_children:
  // Only sync Face/Hair if freeze or enable is active for this slot
  mov eax, [r8+28]
  or eax, [r8+38]
  test eax, eax
  jz hook_done
  cmp dword ptr [rsp+0B8], 2
  jl hook_done

  // Initialize acc at [rsp+80] to identity: scale=(1,1,1), quat=(0,0,0,1), pos=(0,0,0)
  lea rsi, [rsp+80]
  lea rdx, [rsp+0C0]
  mov eax, 3F800000
  mov [rsi], eax
  mov [rsi+04], eax
  mov [rsi+08], eax
  xor ecx, ecx
  mov [rsi+10], ecx
  mov [rsi+14], ecx
  mov [rsi+18], ecx
  mov [rsi+1C], eax
  mov [rsi+20], ecx
  mov [rsi+24], ecx
  mov [rsi+28], ecx

  // Compose Neck chain: bones 0, 1, 2, 9, 10, 11 (offsets 0, 30, 60, 1B0, 1E0, 210)
  mov rdi, r13
  call compose_bone
  lea rdi, [r13+30]
  call compose_bone
  lea rdi, [r13+60]
  call compose_bone
  lea rdi, [r13+1B0]
  call compose_bone
  lea rdi, [r13+1E0]
  call compose_bone
  lea rdi, [r13+210]
  call compose_bone

  // Copy T_neck -> childLp[1] and bodyLp[12] -> childLp[2] for all parts k = 1..partCount-1
  mov rbx, [rsp+0B0]
  add rbx, 0C0                    // start at part[1]
  mov r9d, 1

child_loop:
  cmp r9d, [rsp+0B8]
  jge hook_done

  mov rax, [rbx]
  test rax, rax
  jz next_child
  mov rax, [rax+20]
  test rax, rax
  jz next_child
  mov rcx, [rax+150]              // childSkel
  test rcx, rcx
  jz next_child
  mov rax, [rcx]
  test rax, rax
  jz next_child
  mov rax, [rax]
  test rax, rax
  jz next_child
  movsx eax, word ptr [rax+04]    // childNb
  cmp eax, 3
  jl next_child

  mov rdi, [rcx+10]               // childLp
  test rdi, rdi
  jz next_child

  // Check childLp[0].par==-1, childLp[1].par==0, childLp[2].par==1
  mov eax, [rdi+0C]
  inc eax
  jnz next_child
  cmp dword ptr [rdi+3C], 0
  jne next_child
  cmp dword ptr [rdi+6C], 1
  jne next_child

  // Copy acc (T_neck) -> childLp[1] (+30..+5B, preserving parent at +3C)
  mov eax, [rsi]
  mov [rdi+30], eax
  mov eax, [rsi+04]
  mov [rdi+34], eax
  mov eax, [rsi+08]
  mov [rdi+38], eax
  movups xmm0, [rsi+10]
  movups [rdi+40], xmm0
  mov eax, [rsi+20]
  mov [rdi+50], eax
  mov eax, [rsi+24]
  mov [rdi+54], eax
  mov eax, [rsi+28]
  mov [rdi+58], eax

  // Copy bodyLp[12] (+240..+26B) -> childLp[2] (+60..+8B, preserving parent at +6C)
  mov eax, [r13+240]
  mov [rdi+60], eax
  mov eax, [r13+244]
  mov [rdi+64], eax
  mov eax, [r13+248]
  mov [rdi+68], eax
  movups xmm0, [r13+250]
  movups [rdi+70], xmm0
  mov eax, [r13+260]
  mov [rdi+80], eax
  mov eax, [r13+264]
  mov [rdi+84], eax
  mov eax, [r13+268]
  mov [rdi+88], eax

next_child:
  add rbx, 0C0
  inc r9d
  jmp child_loop

hook_done:
  movups xmm7, [rsp+70]
  movups xmm6, [rsp+60]
  movups xmm5, [rsp+50]
  movups xmm4, [rsp+40]
  movups xmm3, [rsp+30]
  movups xmm2, [rsp+20]
  movups xmm1, [rsp+10]
  movups xmm0, [rsp]
  add rsp, 0D0
  pop rbp
  pop r15
  pop r14
  pop r13
  pop r12
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdi
  pop rsi
  pop rdx
  pop rcx
  pop rbx
  pop rax
  popfq

code:
  db 48 89 5C 24 18
  jmp return

// Helper: compose child bone [rdi] onto acc [rsi], using scratch [rdx]
compose_bone:
  // v = acc.scale * c.pos
  movss xmm0, [rsi]
  mulss xmm0, [rdi+20]
  movss xmm1, [rsi+04]
  mulss xmm1, [rdi+24]
  movss xmm2, [rsi+08]
  mulss xmm2, [rdi+28]

  // t = 2 * cross(q.xyz, v) -> xmm3, xmm4, xmm5
  movss xmm3, [rsi+14]
  mulss xmm3, xmm2
  movss xmm6, [rsi+18]
  mulss xmm6, xmm1
  subss xmm3, xmm6
  addss xmm3, xmm3

  movss xmm4, [rsi+18]
  mulss xmm4, xmm0
  movss xmm6, [rsi+10]
  mulss xmm6, xmm2
  subss xmm4, xmm6
  addss xmm4, xmm4

  movss xmm5, [rsi+10]
  mulss xmm5, xmm1
  movss xmm6, [rsi+14]
  mulss xmm6, xmm0
  subss xmm5, xmm6
  addss xmm5, xmm5

  // v' = v + qw*t + cross(q.xyz, t); acc.pos += v'
  movss xmm7, [rsi+1C]

  movss xmm6, xmm7
  mulss xmm6, xmm3
  addss xmm0, xmm6
  movss xmm6, [rsi+14]
  mulss xmm6, xmm5
  addss xmm0, xmm6
  movss xmm6, [rsi+18]
  mulss xmm6, xmm4
  subss xmm0, xmm6
  addss xmm0, [rsi+20]
  movss [rsi+20], xmm0

  movss xmm6, xmm7
  mulss xmm6, xmm4
  addss xmm1, xmm6
  movss xmm6, [rsi+18]
  mulss xmm6, xmm3
  addss xmm1, xmm6
  movss xmm6, [rsi+10]
  mulss xmm6, xmm5
  subss xmm1, xmm6
  addss xmm1, [rsi+24]
  movss [rsi+24], xmm1

  movss xmm6, xmm7
  mulss xmm6, xmm5
  addss xmm2, xmm6
  movss xmm6, [rsi+10]
  mulss xmm6, xmm4
  addss xmm2, xmm6
  movss xmm6, [rsi+14]
  mulss xmm6, xmm3
  subss xmm2, xmm6
  addss xmm2, [rsi+28]
  movss [rsi+28], xmm2

  // acc.quat = normalize(acc.quat * c.quat)
  movss xmm0, [rsi+1C]
  mulss xmm0, [rdi+10]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+1C]
  addss xmm0, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+18]
  addss xmm0, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+14]
  subss xmm0, xmm4

  movss xmm1, [rsi+1C]
  mulss xmm1, [rdi+14]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+18]
  subss xmm1, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+1C]
  addss xmm1, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+10]
  addss xmm1, xmm4

  movss xmm2, [rsi+1C]
  mulss xmm2, [rdi+18]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+14]
  addss xmm2, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+10]
  subss xmm2, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+1C]
  addss xmm2, xmm4

  movss xmm3, [rsi+1C]
  mulss xmm3, [rdi+1C]
  movss xmm4, [rsi+10]
  mulss xmm4, [rdi+10]
  subss xmm3, xmm4
  movss xmm4, [rsi+14]
  mulss xmm4, [rdi+14]
  subss xmm3, xmm4
  movss xmm4, [rsi+18]
  mulss xmm4, [rdi+18]
  subss xmm3, xmm4

  movaps xmm4, xmm0
  mulss xmm4, xmm4
  movaps xmm5, xmm1
  mulss xmm5, xmm5
  addss xmm4, xmm5
  movaps xmm5, xmm2
  mulss xmm5, xmm5
  addss xmm4, xmm5
  movaps xmm5, xmm3
  mulss xmm5, xmm5
  addss xmm4, xmm5
  sqrtss xmm4, xmm4
  divss xmm0, xmm4
  divss xmm1, xmm4
  divss xmm2, xmm4
  divss xmm3, xmm4

  movss [rsi+10], xmm0
  movss [rsi+14], xmm1
  movss [rsi+18], xmm2
  movss [rsi+1C], xmm3

  // acc.scale *= c.scale
  movss xmm0, [rsi]
  mulss xmm0, [rdi]
  movss [rsi], xmm0
  movss xmm1, [rsi+04]
  mulss xmm1, [rdi+04]
  movss [rsi+04], xmm1
  movss xmm2, [rsi+08]
  mulss xmm2, [rdi+08]
  movss [rsi+08], xmm2
  ret

DOA6_UpdateParts:
  jmp newmem
return:

registersymbol(DOA6_UpdateParts)
registersymbol(g_poseData)

[DISABLE]
DOA6_UpdateParts:
  db 48 89 5C 24 18

unregistersymbol(DOA6_UpdateParts)
unregistersymbol(g_poseData)
dealloc(newmem)
dealloc(g_poseData)
]]></AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"2. 重新打开姿态编辑面板（关闭窗口后可再点此项）"</Description>
      <Color>008000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[
[ENABLE]
{$lua}
if not syntaxcheck then
  Doa6Pose_WantShow = true
end
{$asm}
[DISABLE]
]]></AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
-- ============================================================================
-- DOA6 角色姿态修改器 (Hook: DOA6_UpdateParts @ DOA6.exe+0x405C40)
-- 全部 GUI 与定时器均运行在 CE 主线程，带可视化人体关节交互面板
-- ============================================================================

local MAX_BONES = 256
local DELTA_BASE = { [0] = 0x0100, [1] = 0x2100 }
local UI_VERSION = 2

local BONE_LIST = {
  { id = 1,  name = "1  整体位置/高度 (Root)" },
  { id = 2,  name = "2  骨盆 / 全身旋转 (Pelvis)" },
  { id = 9,  name = "9  腰部 / 下脊柱 (Waist)" },
  { id = 10, name = "10 胸部 / 上脊柱 (Chest)" },
  { id = 11, name = "11 颈部 (Neck)" },
  { id = 12, name = "12 头部 (Head)" },
  { id = 13, name = "13 左锁骨 / 左肩 (L Clavicle)" },
  { id = 15, name = "15 左上臂 (L UpperArm)" },
  { id = 17, name = "17 左前臂 / 左肘 (L Forearm)" },
  { id = 19, name = "19 左手腕 (L Hand)" },
  { id = 14, name = "14 右锁骨 / 右肩 (R Clavicle)" },
  { id = 16, name = "16 右上臂 (R UpperArm)" },
  { id = 18, name = "18 右前臂 / 右肘 (R Forearm)" },
  { id = 20, name = "20 右手腕 (R Hand)" },
  { id = 3,  name = "3  左大腿 / 左髋 (L Thigh)" },
  { id = 5,  name = "5  左小腿 / 左膝 (L Knee)" },
